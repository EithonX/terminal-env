font-family = "MonaspiceNe Nerd Font"
font-size = 13
background = #0a0e13
foreground = #e6ebf0
cursor-color = #7cc4e4
cursor-style = bar
selection-background = #1b232d
selection-foreground = #e6ebf0
palette = 0=#0a0e13
palette = 1=#e07880
palette = 2=#8bb594
palette = 3=#d6a85f
palette = 4=#7fa9c4
palette = 5=#a99db8
palette = 6=#7cc4e4
palette = 7=#e6ebf0
palette = 8=#707c88
palette = 9=#e69aa0
palette = 10=#a3c5a9
palette = 11=#e2bf82
palette = 12=#9bbfd3
palette = 13=#bbb0c8
palette = 14=#a0d5e5
palette = 15=#f4f6f8
window-padding-x = 12
window-padding-y = 10
confirm-close-surface = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
clipboard-read = ask
clipboard-write = allow
shell-integration = detect
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1
