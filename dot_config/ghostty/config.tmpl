font-family = "MonaspiceNe Nerd Font"
font-size = 13
background = #090d12
foreground = #e7edf3
cursor-color = #7dd7ff
cursor-style = bar
selection-background = #1f2731
selection-foreground = #eff4f8
palette = 0=#090d12
palette = 1=#f38ba8
palette = 2=#a6d189
palette = 3=#e5c07b
palette = 4=#8ab4ff
palette = 5=#c5a6f5
palette = 6=#7dd7ff
palette = 7=#e7edf3
palette = 8=#6c7986
palette = 9=#f5a4bc
palette = 10=#b7dc9f
palette = 11=#edd29b
palette = 12=#a7c5ff
palette = 13=#d3bcf7
palette = 14=#9de0ff
palette = 15=#f3f7fb
window-padding-x = 12
window-padding-y = 10
confirm-close-surface = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
clipboard-read = ask
clipboard-write = allow
shell-integration = detect
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1
