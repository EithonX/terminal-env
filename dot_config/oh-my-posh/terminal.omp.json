{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "streaming": 100,
  "shell_integration": true,
  "console_title_template": "{{ .Folder }}{{ if .Root }} · {{ if eq .OS \"windows\" }}admin{{ else }}root{{ end }}{{ end }}{{ if .SSHSession }} · {{ .HostName }}{{ end }}",
  "palette": {
    "bg": "#0A0E13",
    "surface": "#151B22",
    "surface_active": "#1B232D",
    "line": "#28323D",
    "text": "#E6EBF0",
    "soft": "#A2ACB7",
    "muted": "#707C88",
    "accent": "#7CC4E4",
    "warning": "#D6A85F",
    "danger": "#E07880",
    "success": "#8BB594"
  },
  "palettes": {
    "template": "{{ if .Env.NO_COLOR }}plain{{ end }}",
    "list": {
      "plain": {
        "bg": "transparent",
        "surface": "transparent",
        "surface_active": "transparent",
        "line": "transparent",
        "text": "transparent",
        "soft": "transparent",
        "muted": "transparent",
        "accent": "transparent",
        "warning": "transparent",
        "danger": "transparent",
        "success": "transparent"
      }
    }
  },
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "p:muted",
    "template": "↪ ",
    "multiline_keepprompt": true
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:soft",
          "template": "{{ if .SSHSession }}{{ .HostName }}  {{ end }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:accent",
          "template": "{{ .Path }}",
          "options": {
            "style": "agnoster_short",
            "max_depth": 4,
            "folder_separator_icon": "/",
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:soft",
          "template": "{{ if .HEAD }}  {{ .HEAD }}{{ if gt .Staging.Added 0 }} <p:warning>+{{ .Staging.Added }}</>{{ end }}{{ if gt (add .Working.Modified .Staging.Modified) 0 }} <p:warning>~{{ add .Working.Modified .Staging.Modified }}</>{{ end }}{{ if gt .Working.Untracked 0 }} <p:warning>?{{ .Working.Untracked }}</>{{ end }}{{ if gt (add .Working.Deleted .Staging.Deleted) 0 }} <p:warning>-{{ add .Working.Deleted .Staging.Deleted }}</>{{ end }}{{ if gt .Ahead 0 }} <p:soft>↑{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }} <p:warning>↓{{ .Behind }}</>{{ end }}{{ if gt .Working.Unmerged 0 }} <p:danger>!{{ .Working.Unmerged }}</>{{ end }}{{ end }}",
          "timeout": 1000,
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": false
          }
        },
        {
          "type": "text",
          "alias": "project-context",
          "style": "plain",
          "foreground": "p:muted",
          "foreground_templates": [
            "{{ if eq .Env.TERMINAL_ENV_PROJECT_CONTEXT_STATE \"warning\" }}p:warning{{ end }}"
          ],
          "template": "{{ if .Env.TERMINAL_ENV_PROJECT_CONTEXT }}  {{ .Env.TERMINAL_ENV_PROJECT_CONTEXT }}{{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:muted",
          "template": " │ "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:danger",
          "template": "{{ if .Executed }}{{ .String }} {{ end }}",
          "options": {
            "always_enabled": false,
            "status_template": "{{ .Code }}",
            "status_separator": "|"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:text",
          "foreground_templates": [
            "{{ if .Root }}p:danger{{ end }}"
          ],
          "template": "{{ if .Root }}#{{ else }}❯{{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:text",
          "template": " "
        }
      ]
    }
  ],
  "upgrade": {
    "notice": false,
    "auto": false
  }
}
